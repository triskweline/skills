#!/bin/bash
# SessionStart hook: hands the dradis rule to the agent. Plain stdout becomes session context.
# After a resume, fork or compaction the file may be stale or missing, so the agent gets told to
# fix it in its first turn (it can't notice a resume by itself).
input=$(cat)
source=$(printf '%s' "$input" | jq -r '.source // empty' 2>/dev/null)

cat "$(dirname "$0")/../rule.md"

case "$source" in
  resume)  event=resumed ;;
  fork)    event=forked ;;
  compact) event=compacted ;;
esac
if [ -n "$event" ]; then
  printf '\nThis session was just %s. The dradis file may be stale or missing: read it and correct it in this turn.\n' "$event"
fi
